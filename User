exports.createUserProfile = onRequest(async (req, res) => {
    // 💡 1. 安全防护：只允许前端发送 POST 请求
    if (req.method !== "POST") {
        return res.status(405).json({ 
            status: "error", 
            message: "Only POST requests are allowed" 
        });
    }

    try {
        // 从前端 Flutter 的 body 中解构提取数据
        const {uid, name, phone, password, role} = req.body;

        // 💡 2. 严格的输入验证 (Input Validation)
        // 检查必填项是否存在且不为空
        if (!uid || validator.isEmpty(uid.trim())) {
            return res.status(400).json({ status: "error", message: "Missing or invalid UID" });
        }
        if (!name || validator.isEmpty(name.trim())) {
            return res.status(400).json({ status: "error", message: "Name cannot be empty" });
        }
        if (!phone || validator.isEmpty(phone.trim())) {
            return res.status(400).json({ status: "error", message: "Phone cannot be empty" });
        }
        if (!password || !validator.isEmpty(password.trim)) {
            return res.status(400).json({ status: "error", message: "Password cannot be empty" });
        }

        // 💡 3. 安全符号转换 (Input Sanitization / XSS 防护)
        // 使用 validator.escape() 把危险符号（如 <, >, &, ", '）转换成安全的 HTML 实体
        // 这样黑客输入的 <script> 就会变成安全的 &lt;script&gt; 
        const safeName = validator.escape(name.trim());
        const safePhone = validator.escape(phone.trim());
        const safePassword = validator.escape(password.trim()); // 规范化邮箱（如大写转小写）
        

        // 💡 4. 构建最终安全的 User 对象
        const userObject = {
            name: safeName,
            phone: safePhone,
            role: "user",                // 后端强制赋予默认角色，防止前端篡改权限
            createdAt: admin.firestore.FieldValue.serverTimestamp(), // 使用服务器绝对时间
        };

        // 💡 5. 安全写入 Cloud Firestore 数据库
        // 使用 .doc(safePhone+safeName).set(...) 确保每个 Phone 对应唯一的文档
        // Firestore 天然防御 SQL 注入，此时数据已绝对安全
        await db.collection("users").doc(safeUid).set(userObject);

        // 💡 6. 成功回传给前端 Flutter
        return res.status(201).json({
            status: "success",
            message: "User profile secured and saved successfully",
            data: {
                uid: safeUid,
                name: safeName
            }
        });

    } catch (error) {
        // 捕获未知错误（如数据库连接断开），打印到控制台日志
        console.error("Backend Error:", error);
        
        // 不要把详细的系统错误直接暴露给前端（防止暴露后端隐私）
        return res.status(500).json({ 
            status: "error", 
            message: "Internal server error occurred" 
        });
    }
});

