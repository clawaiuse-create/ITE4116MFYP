// flutter side, get data from sharepreferences for auto login
===============================================
class ExistingUser{
final String uid;
  final String phone;
  final String role;

  ExistingUser({required this.uid, required this.phone, required this.role});

  // 💡 核心功能：提供一个工厂构造函数，直接从 SharedPreferences 中抽取数据
  static Future<ExistingUser?> fromSharedPreferences() async {
    final prefs = await SharedPreferences.getInstance();
    
    final String? uid = prefs.getString('uid');
    final String? phone = prefs.getString('phone');
    final String? role = prefs.getString('role');

    // 如果任何一个核心登录凭证丢失，说明用户之前没登录成功，或者登出了
    if (uid == null || phone == null || role == null) {
      return null; 
    }

    return ExistingUser(uid: uid, phone: phone, role: role);
  }


  // 💡 将对象转为 JSON 格式，方便用 Dio 传给后端
  Map<String, dynamic> toJson() {
    return {
      'uid': uid,
      'phone': phone,
      'role': role,
    };
  }
}


