const { Storage } = require("@google-cloud/storage");
const storage = new Storage();

exports.uploadYOLORecord = onRequest(async (req, res) => {
    if (req.method !== "POST") {
        return res.status(405).json({ status: "error", message: "Only POST allowed" });
    }

    try {
        // 💡 顺应你的建议，彻底拿掉了 description，只保留最核心的三个 YOLO 字段
        const { imageID, uID, aiSuggestedLabel } = req.body;

        // 1. 基础字段验证
        if (!imageID || validator.isEmpty(imageID.trim())) return res.status(400).json({ status: "error", message: "imageID (URL) required" });
        if (!uID || validator.isEmpty(uID.trim())) return res.status(400).json({ status: "error", message: "uID required" });
        if (!aiSuggestedLabel) return res.status(400).json({ status: "error", message: "aiSuggestedLabel object required" });

        // 2. 嵌套对象属性解构与验证
        const { classIndex, className, confidenceScore } = aiSuggestedLabel;
        if (classIndex === undefined || !className || confidenceScore === undefined) {
            return res.status(400).json({ status: "error", message: "Incomplete aiSuggestedLabel attributes" });
        }

        // 3. 安全符号转换 & 格式化
        const safeUid = uID.trim();
        const safeImageUrl = imageID.trim();
        const safeClassName = validator.escape(String(className).trim()); // 清洗 YOLO 类名，防止恶意标签 XSS
        const safeClassIndex = parseInt(classIndex, 10);
        const safeConfidence = parseFloat(confidenceScore);

        // 验证 URL 合法性
        if (!validator.isURL(safeImageUrl)) {
            return res.status(400).json({ status: "error", message: "Invalid imageID URL format" });
        }

        // 4. 组装安全的业务文档数据模型
        const yoloRecordDocument = {
            userId: safeUid,
            imageUrl: safeImageUrl, // 对应前端传来的图片 Storage 链接
            aiSuggestedLabel: {
                classIndex: safeClassIndex,
                className: safeClassName,
                confidenceScore: safeConfidence
            },
            isLowConfidenceSample: safeConfidence < 0.80, // 再次在后端标记，方便后续模型审计
            createdAt: admin.firestore.FieldValue.serverTimestamp() // 使用服务器绝对时间
        };

        // 5. 写入 Firestore 的 'yolo_detections' 集合
        await db.collection("yolo_detections").add(yoloRecordDocument);

        return res.status(201).json({
            status: "success",
            message: "YOLO low-confidence diagnostic record secured and saved successfully"
        });

    } catch (error) {
        console.error("YOLO Record Upload Error:", error);
        return res.status(500).json({ status: "error", message: "Internal server error" });
    }
});
