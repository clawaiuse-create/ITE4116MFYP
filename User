//user class and constructor
class User{
constructor(uid, name, phone, password, role) {
        this.uid = uid;
        this.name = name;    //使用者名稱
        this.phone = phone;   //login PK
        this.password = password;  //密碼
        this.role = role;   //default normalUser
        this.createdAt = new Date();
    }

//user login process
const { onRequest } = require("firebase-functions/v2/https");
const admin = require("firebase-admin");
const validator = require("validator");
const bcrypt = require("bcryptjs"); // 💡 新增：用于密码加密，保障网络安全

admin.initializeApp();
const db = admin.firestore();

/**
 * 1. 🛠️ 用户注册流程 (Register / Sign Up)
 */
exports.registerUser = onRequest(async (req, res) => {
    if (req.method !== "POST") {
        return res.status(405).json({ status: "error", message: "Only POST allowed" });
    }

    try {
        const { uid, name, phone, password } = req.body;

        // 验证必填
        if (!uid || validator.isEmpty(uid.trim())) return res.status(400).json({ status: "error", message: "Invalid UID" });
        if (!name || validator.isEmpty(name.trim())) return res.status(400).json({ status: "error", message: "Name required" });
        if (!phone || validator.isEmpty(phone.trim())) return res.status(400).json({ status: "error", message: "Phone required" });
        if (!password || validator.isEmpty(password.trim())) return res.status(400).json({ status: "error", message: "Password required" });

        // 数据清理
        const safeUid = uid.trim();
        const safeName = validator.escape(name.trim());
        const safePhone = validator.escape(phone.trim());

        // 💡 密码安全核心：加盐加密（Salt Hashing），绝对不能明文存入数据库，也不能做 escape
        const salt = await bcrypt.genSalt(10);
        const hashedPassword = await bcrypt.hash(password.trim(), salt);

        // 检查手机号是否已被注册
        const userCheck = await db.collection("users").where("phone", "==", safePhone).get();
        if (!userCheck.empty) {
            return res.status(400).json({ status: "error", message: "Phone number already registered" });
        }

        const userObject = {
            uid: safeUid,
            name: safeName,
            phone: safePhone,
            password: hashedPassword, // 存入加密后的密文
            role: "user",
            createdAt: admin.firestore.FieldValue.serverTimestamp(),
        };

        // 以 UID 作为 PK 写入数据库
        await db.collection("users").doc(safeUid).set(userObject);

        return res.status(201).json({
            status: "success",
            message: "User registered successfully",
            data: { uid: safeUid, name: safeName }
        });

    } catch (error) {
        console.error("Register Error:", error);
        return res.status(500).json({ status: "error", message: "Internal server error" });
    }
});

/**
 * 2. 🔑 用户登录流程 (Login / Sign In)
 */
exports.loginUser = onRequest(async (req, res) => {
    if (req.method !== "POST") {
        return res.status(405).json({ status: "error", message: "Only POST allowed" });
    }

    try {
        const { phone, password } = req.body;

        if (!phone || !password) {
            return res.status(400).json({ status: "error", message: "Phone and password are required" });
        }

        const safePhone = validator.escape(phone.trim());

        // 💡 登录核心逻辑：去数据库里找这个手机号的用户
        const userQuery = await db.collection("users").where("phone", "==", safePhone).limit(1).get();

        if (userQuery.empty) {
            return res.status(401).json({ status: "error", message: "User not found or wrong password" });
        }

        // 拿到数据库里的用户数据
        const userDoc = userQuery.docs[0];
        const userData = userDoc.data();

        // 💡 比对前端输入的明文密码与数据库里的加密密码是否匹配
        const isMatch = await bcrypt.compare(password.trim(), userData.password);

        if (!isMatch) {
            // 安全小技巧：不要明确告诉黑客是密码错了还是账号错了，统一返回相同提示
            return res.status(401).json({ status: "error", message: "User not found or wrong password" });
        }

        // 登录成功，回传资料给前端 Flutter（注意：绝对不要把密码回传给前端）
        return res.status(200).json({
            status: "success",
            message: "Login successful",
            data: {
                uid: userData.uid,
                name: userData.name,
                phone: userData.phone,
                role: userData.role
            }
        });

    } catch (error) {
        console.error("Login Error:", error);
        return res.status(500).json({ status: "error", message: "Internal server error" });
    }
});
