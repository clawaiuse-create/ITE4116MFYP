exports.uploadUserPost = onRequest(async (req, res) => {
    if (req.method !== "POST") {
        return res.status(405).json({ status: "error", message: "Only POST allowed" });
    }

    try {
        // 💡 调整：前端依然只需要传 uid, imageUrl 和描述，不需要自己算属性
        const { uid, imageUrl, description } = req.body;

        if (!uid || !imageUrl) {
            return res.status(400).json({ status: "error", message: "Missing uid or imageUrl" });
        }

        const safeUid = uid.trim();
        const safeImageUrl = imageUrl.trim();
        const safeDescription = description ? validator.escape(description.trim()) : "";

        // ====================================================================
        // 💡 核心加分点：后端从线上 Storage 文件中动态抽取属性 (Extract Metadata)
        // ====================================================================
        // 解析前端传来的 URL，提取出图片在 Storage 里的真实存储路径
        // 例如：从 https://googleapis.com 
        // 提取出路径： 'posts/123.jpg'
        const bucket = admin.storage().bucket();
        // 简单地通过切割 URL 拿到文件名（这部分可以根据你前端定义的路径做简单调整）
        const decodedPath = decodeURIComponent(safeImageUrl.split("/o/")[1].split("?")[0]);
        const file = bucket.file(decodedPath);

        // 顺着网络直接读取该图片的云端元数据
        const [metadata] = await file.getMetadata();

        // 提取出的权威图片属性
        const imageAttributes = {
            fileSize: metadata.size,          // 图片文件大小（字节数）
            contentType: metadata.contentType,// 图片格式（例如 image/jpeg）
            updatedTime: metadata.updated,    // 文件在云端的最后修改时间
            md5Hash: metadata.md5Hash         // 图片的唯一哈希指纹（用于防篡改、查重）
        };
        // ====================================================================

        // 将基础信息与后端动态抽取的属性融合成最终的数据库文档
        const postObject = {
            userId: safeUid,
            imageUrl: safeImageUrl,
            description: safeDescription,
            imageSpec: imageAttributes,       // 💡 优雅地将抽取的属性作为子 JSON 写入数据库
            createdAt: admin.firestore.FieldValue.serverTimestamp()
        };

        // 写入 Firestore 数据库
        await db.collection("posts").add(postObject);

        return res.status(201).json({
            status: "success",
            message: "Image uploaded and attributes securely extracted by backend",
            extractedSpec: imageAttributes // 可以顺便把抽出来的属性回传给前端看
        });

    } catch (error) {
        console.error("Extract & Upload Post Error:", error);
        return res.status(500).json({ status: "error", message: "Internal server error" });
    }
});
